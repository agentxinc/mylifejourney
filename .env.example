# Google Gemini API Key - Get yours at https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Default: gemini-3.5-flash (2.5* returns 404 for new API keys)
# GEMINI_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------------------
# Provider chain + timeouts (all optional; defaults = today's behavior)
# Hard cap: the whole chain always finishes within 14.5s (SERVER_TIMEOUT_MS),
# whatever these say. Each step is clamped to the budget still left, and a step
# with < 1s left is skipped. Nothing is retried on the same provider.
# ---------------------------------------------------------------------------
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# MLJ_PRIMARY_TIMEOUT_MS=10000   # gemini-primary step
# MLJ_FALLBACK_TIMEOUT_MS=4000   # gemini-lite step

# Optional Groq fallback. OFF unless BOTH are set. Key goes in Vercel as an
# encrypted env var only; it is never logged.
# MLJ_FALLBACK_PROVIDER=groq
# GROQ_API_KEY=
# MLJ_GROQ_MODEL=openai/gpt-oss-120b
# MLJ_GROQ_TIMEOUT_MS=4000
# Groq 429/5xx/timeout -> next provider, or BUSY if it was the last one.

# Order (comma list of gemini-primary, gemini-lite, groq). Default:
#   gemini-primary,gemini-lite            (groq appended when enabled above)
# Note: in Gemini-first order Groq realistically only helps after a FAST 503:
# 10s + ~0.2s pause + 4s leaves ~0.3s, so Groq is skipped after a timeout.
# MLJ_PROVIDER_ORDER=gemini-primary,gemini-lite,groq
#
# Groq-primary preset (Groq ~7s, then gemini-3.5-flash on the ~7.2s left):
# MLJ_PROVIDER_ORDER=groq,gemini-primary
# MLJ_GROQ_TIMEOUT_MS=7000
